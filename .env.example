# OpenAI-compatible endpoint (cloud or local)
PIXELFORGE_BASE_URL=https://api.openai.com/v1

# Required model name for `pixelforge ask`
PIXELFORGE_MODEL=your-model-name

# API key — leave empty for local servers that do not require auth
PIXELFORGE_API_KEY=

# Optional limits
PIXELFORGE_TIMEOUT=60
PIXELFORGE_MAX_STEPS=8

# --- Local model examples ---
# Ollama:
#   PIXELFORGE_BASE_URL=http://localhost:11434/v1
#   PIXELFORGE_MODEL=qwen2.5-coder:14b
#
# LM Studio:
#   PIXELFORGE_BASE_URL=http://localhost:1234/v1
#   PIXELFORGE_MODEL=local-model
#
# vLLM / llama.cpp server:
#   PIXELFORGE_BASE_URL=http://localhost:8000/v1
#   PIXELFORGE_MODEL=your-served-model
